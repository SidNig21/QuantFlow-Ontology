{
  "name": "@quantflow/electron",
  "version": "0.8.4",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "out/main/index.js",
  "scripts": {
    "dev": "bun ./scripts/dev.mjs",
    "pack-agent": "bun run --cwd ../tools/qf-proof-agent pack-agent",
    "build": "node ./scripts/run-local-bin.mjs electron-vite build",
    "preview": "node ./scripts/run-local-bin.mjs electron-vite preview",
    "clean": "bun ./scripts/clean.mjs",
    "clean:deep": "bun ./scripts/clean.mjs --deep",
    "package": "bun ./scripts/package.mjs",
    "package:verify": "bun ./scripts/package-verify.ts",
    "package:unsigned": "bun ./scripts/package.mjs --no-sign",
    "shortcut:refresh": "bun ./scripts/refresh-desktop-shortcut.mjs",
    "release": "bun ./scripts/package.mjs --publish",
    "test": "bun test",
    "test:updater": "bun test src/main/updater/github-release-fetcher.test.ts && bun test src/main/updater/downloader.test.ts && bun test src/main/updater/update-manager.test.ts",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "build": {
    "appId": "com.quantflow.ontology",
    "productName": "QuantFlow",
    "publish": [
      {
        "provider": "github",
        "owner": "SidNig21",
        "repo": "QuantFlow-Ontology"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      {
        "from": "out",
        "to": "out",
        "filter": [
          "**/*"
        ]
      },
      "package.json",
      "NOTICE"
    ],
    "asarUnpack": [
      "node_modules/@img/sharp-libvips-linux-x64/**/*",
      "node_modules/@img/sharp-libvips-linuxmusl-x64/**/*"
    ],
    "afterSign": "scripts/notarize.cjs",
    "afterAllArtifactBuild": "scripts/fix-artifacts.cjs",
    "extraResources": [
      {
        "from": "resources/tmux.conf",
        "to": "tmux.conf"
      },
      {
        "from": "resources/terminfo",
        "to": "terminfo"
      },
      {
        "from": "cli/collab-cli.mjs",
        "to": "collab-cli.mjs"
      },
      {
        "from": "cli/qf-collaboration-mcp.mjs",
        "to": "qf-collaboration-mcp.mjs"
      },
      {
        "from": "cli/qf-ontology-mcp.mjs",
        "to": "qf-ontology-mcp.mjs"
      },
      {
        "from": "cli/qf-hermes-launch.sh",
        "to": "qf-hermes-launch.sh"
      },
      {
        "from": "cli/qf-hermes-synthetic-responder.mjs",
        "to": "qf-hermes-synthetic-responder.mjs"
      },
      {
        "from": "packages/collab-canvas-skill",
        "to": "collab-canvas-skill"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "QuantFlow needs microphone access to enable voice input for CLI tools like Claude Code."
      },
      "extraResources": [
        {
          "from": "vendor/tmux/tmux",
          "to": "tmux"
        },
        {
          "from": "vendor/tmux/lib",
          "to": "lib"
        }
      ],
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "extraResources": [
        {
          "from": ".package-staging",
          "to": "."
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Development",
      "executableName": "quantflow",
      "extraResources": [
        {
          "from": ".package-staging",
          "to": "."
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": "x64"
        }
      ]
    }
  },
  "dependencies": {


    "@agentclientprotocol/sdk": "0.18.2",
    "@lezer/common": "^1.5.1",
    "@lezer/python": "^1.1.18",
    "@parcel/watcher": "2.5.6",
    "@postlight/parser": "^2.2.3",
    "dependency-cruiser": "^17.3.8",
    "electron-log": "5.4.3",
    "electron-updater": "6.8.3",
    "front-matter": "4.0.2",
    "ignore": "7.0.5",
    "node-pty": "^1.1.0",
    "posthog-node": "^5.28.0",
    "qf-bovada-football": "file:../tools/qf-bovada-football",
    "qf-kernel": "file:../packages/qf-kernel",
    "qf-kernel-schema": "file:../qf-kernel-schema",
    "sharp": "0.34.5",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.34.5",
    "@img/sharp-darwin-x64": "0.34.5",
    "@img/sharp-libvips-darwin-arm64": "1.2.4",
    "@img/sharp-libvips-darwin-x64": "1.2.4",
    "@img/sharp-libvips-linux-x64": "1.2.4",
    "@img/sharp-linux-x64": "0.34.5",
    "@parcel/watcher-darwin-arm64": "2.5.6",
    "@parcel/watcher-darwin-x64": "2.5.6"
  },
  "devDependencies": {


    "@blocknote/core": "0.47.0",
    "@blocknote/mantine": "0.47.0",
    "@blocknote/react": "0.47.0",
    "@electron/asar": "3.4.1",
    "@electron/notarize": "2.5.0",
    "@electron/rebuild": "^4.0.3",
    "@octokit/rest": "22.0.1",
    "@phosphor-icons/react": "2.1.7",
    "@posthog/react": "^1.8.2",
    "@tailwindcss/vite": "4.2.0",
    "@tiptap/core": "3.20.0",
    "@tiptap/extension-typography": "3.20.0",
    "@types/d3": "7.4.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "d3": "7.9.0",
    "electron": "40.6.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "katex": "0.16.33",

    "monaco-editor": "^0.55.1",
    "posthog-js": "^1.359.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwindcss": "4.2.0",
    "tsx": "^4.20.3"
  }
}
