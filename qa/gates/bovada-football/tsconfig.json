{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "baseUrl": "../../../",
    "paths": {
      "@collab/shared": ["collab-electron/packages/shared/src"],
      "@collab/shared/*": ["collab-electron/packages/shared/src/*"],
      "@collab/components": ["collab-electron/packages/components/src"],
      "@collab/components/*": ["collab-electron/packages/components/src/*"],
      "@collab/theme": ["collab-electron/packages/theme/src"],
      "@collab/theme/*": ["collab-electron/packages/theme/src/*"]
    }
  },
  "include": ["run.ts"]
}
