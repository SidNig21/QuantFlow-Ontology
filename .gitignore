.DS_Store
*.swp
*.swo
*~
# docs/ is an ALLOWLIST: everything is ignored, then named paths are restored.
# A new directory under docs/ is therefore invisible to git until it is listed
# here — `git add` reports nothing and the work is silently lost. That has cost
# us three times (ADR-0001, readme-assets, V2-SCOPE). Adding a docs/ directory?
# Add its two lines below in the same commit.
docs/*
!docs/adr/
!docs/adr/**
!docs/history/
!docs/history/**
!docs/LAWS.md
!docs/DEBT.md
!docs/orders/
!docs/orders/**
!docs/demos/
!docs/demos/**
!docs/DOCTRINE.md
!docs/RESEARCH.md
!docs/BLUEPRINT.md
!docs/ONTOLOGY_SCHEMA.md
!docs/ROADMAP.md
!docs/readme-assets/
!docs/readme-assets/**
!docs/proposals/
!docs/proposals/**
.collaborator
.superpowers
.claude/
notes/
Screenshots/
.worktrees
opencode.json
/collab-electron/.antigravitycli
qa/.tmp-agent-path/
*.code-workspace
# qf-kernel-schema package-local ignores. These stay scoped to this package
# after removing its nested .gitignore so Bun's local file dependency copy no
# longer traverses an ignore file on Windows.
/qf-kernel-schema/**/node_modules
/qf-kernel-schema/**/out
/qf-kernel-schema/**/dist
/qf-kernel-schema/**/*.tgz
/qf-kernel-schema/**/coverage
/qf-kernel-schema/**/*.lcov
/qf-kernel-schema/**/logs
/qf-kernel-schema/**/_.log
/qf-kernel-schema/**/report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json
/qf-kernel-schema/**/.env
/qf-kernel-schema/**/.env.development.local
/qf-kernel-schema/**/.env.test.local
/qf-kernel-schema/**/.env.production.local
/qf-kernel-schema/**/.env.local
/qf-kernel-schema/**/.eslintcache
/qf-kernel-schema/**/.cache
/qf-kernel-schema/**/*.tsbuildinfo
/qf-kernel-schema/**/.idea
/qf-kernel-schema/**/.DS_Store

# Gate-owned package installs are disposable and must not poison the clean
# checkout required by the release/package gates.
/qa/gates/**/node_modules/
