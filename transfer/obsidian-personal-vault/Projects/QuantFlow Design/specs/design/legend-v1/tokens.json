{
  "version": "1.0.0",
  "slice": "Slice 1 — Legend v1",
  "lastUpdated": "2026-05-25",

  "dock": {
    "placement": {
      "container": "#panel-viewer",
      "position": "absolute",
      "left": 12,
      "top": 12,
      "bottom": 44,
      "zIndex": 20,
      "note": "Pin to the left edge of the canvas viewer, NOT inside the Files/Tiles nav."
    },
    "width": {
      "compact": 56,
      "comfortable": 240,
      "transition": "width 220ms ease"
    },
    "background": "rgba(13, 17, 23, 0.78)",
    "backdropFilter": "blur(10px)",
    "border": "1px solid #1c232d",
    "borderRadius": 10,
    "boxShadow": "0 8px 28px rgba(0, 0, 0, 0.55)",
    "overflow": "hidden",
    "_treatment": "Same glass treatment as the minimap. Reads as canvas chrome, not nav."
  },

  "header": {
    "compact":     { "paddingX": 8,  "paddingTopBottom": "8px 8px 6px",  "justify": "center"        },
    "comfortable": { "paddingX": 14, "paddingTopBottom": "10px 14px 6px","justify": "space-between" },
    "borderBottom": "1px solid color-mix(in srgb, #1c232d 60%, transparent)",
    "title": {
      "text":           "Legend",
      "fontFamily":     "system-ui",
      "fontSize":       12,
      "fontWeight":     600,
      "color":          "#e7ecf2",
      "letterSpacing": "-0.005em",
      "_hideWhen":      "compact"
    },
    "eyebrow": {
      "text":           "spawn",
      "fontFamily":     "ui-monospace",
      "fontSize":       9,
      "color":          "#4a5466",
      "textTransform": "uppercase",
      "letterSpacing": "0.1em",
      "_hideWhen":      "compact"
    },
    "compactGlyph": {
      "type":   "double chevron",
      "size":   18,
      "stroke": "#5bd17a",
      "_note":  "Renders only in compact mode; replaces the wordmark"
    }
  },

  "groups": {
    "order": ["agents", "workers", "shell"],
    "label": {
      "fontFamily":     "ui-monospace",
      "fontSize":       9.5,
      "color":          "#6b7686",
      "textTransform": "uppercase",
      "letterSpacing": "0.08em",
      "padding":       "10px 14px 4px",
      "_hideWhen":      "compact",
      "_compactReplacement": "1px top border with 8px margin (separator only, no text)"
    }
  },

  "recipeRow": {
    "margin": "2px 8px",
    "padding": {
      "compact":     "6px",
      "comfortable": "7px 10px"
    },
    "gap": {
      "compact":     0,
      "comfortable": 10
    },
    "borderRadius": 7,
    "iconDisc": {
      "size":         28,
      "borderRadius": 6,
      "border":       "1px solid color-mix(in srgb, [roleColor] 30%, transparent)",
      "background":   "color-mix(in srgb, [roleColor] 14%, transparent)",
      "iconSize":     16,
      "iconStroke":   1.35
    },
    "label": {
      "fontFamily":  "system-ui",
      "fontSize":    12.5,
      "fontWeight":  500,
      "color":       "#e7ecf2",
      "lineHeight":  1.25,
      "_hideWhen":   "compact"
    },
    "description": {
      "fontFamily":  "ui-monospace",
      "fontSize":    10,
      "color":       "#6b7686",
      "lineHeight":  1.2,
      "marginTop":   1,
      "_hideWhen":   "compact"
    },
    "states": {
      "idle": {
        "background": "transparent",
        "border":     "1px solid transparent"
      },
      "hover": {
        "background": "color-mix(in srgb, [roleColor] 12%, transparent)",
        "border":     "1px solid color-mix(in srgb, [roleColor] 30%, transparent)",
        "transition": "background 120ms ease, border-color 120ms ease"
      },
      "active": {
        "background": "color-mix(in srgb, [roleColor] 22%, transparent)",
        "border":     "1px solid color-mix(in srgb, [roleColor] 60%, transparent)",
        "iconDiscBg": "color-mix(in srgb, [roleColor] 24%, transparent)",
        "boxShadow":  "0 0 0 2px color-mix(in srgb, [roleColor] 45%, transparent)",
        "_appliedOn": "click — animate via @keyframes lv1-spawn-pulse for 600ms"
      },
      "disabled": {
        "opacity":    0.35,
        "cursor":     "not-allowed",
        "_appliedWhen": "RL template is armed AND running AND row is in 'workers' group"
      }
    },
    "tooltip": {
      "_appliedOn":    "compact density only, on hover",
      "background":    "#11161d",
      "border":        "1px solid #1c232d",
      "borderRadius":  5,
      "padding":       "5px 9px",
      "fontSize":      11,
      "fontFamily":    "system-ui",
      "color":         "#e7ecf2",
      "boxShadow":     "0 6px 18px rgba(0, 0, 0, 0.6)",
      "offsetLeft":    8,
      "zIndex":        30,
      "lines":         ["[recipe.name]", "[recipe.description]"]
    }
  },

  "templateCard": {
    "margin":       "4px 8px",
    "padding": {
      "compact":     "8px 6px",
      "comfortable": "10px"
    },
    "borderRadius": 8,
    "states": {
      "idle": {
        "background": "color-mix(in srgb, #e7ecf2 4%, transparent)",
        "border":     "1px solid #1c232d"
      },
      "armed": {
        "background": "color-mix(in srgb, [accent] 16%, transparent)",
        "border":     "1px solid color-mix(in srgb, [accent] 55%, transparent)",
        "boxShadow":  "0 0 0 1px [accentGlow], 0 0 16px [accentGlow]",
        "transition": "background 140ms ease, border-color 140ms ease, box-shadow 140ms ease"
      }
    },
    "glyph": {
      "type":  "two offset role-colored squares",
      "size":  28,
      "_built": "small inner box (Hermes color) overlapping larger outer (PufferLib color)"
    },
    "armedBadge": {
      "text":           "● ARMED",
      "fontFamily":     "ui-monospace",
      "fontSize":       9,
      "color":          "[accent]",
      "textTransform": "uppercase",
      "letterSpacing": "0.08em",
      "_hideWhen":      "compact OR idle"
    },
    "templatesSectionLabel": {
      "text": "Templates",
      "_compactReplacement": "TMPL (centered, fontSize 8)"
    }
  },

  "commence": {
    "margin":       "6px 8px",
    "padding": {
      "compact":     "12px 4px",
      "comfortable": "11px 12px"
    },
    "borderRadius": 8,
    "iconSize":     14,
    "transition":   "all 180ms ease",
    "states": {
      "idle": {
        "background":     "transparent",
        "border":         "1px dashed color-mix(in srgb, #6b7686 50%, transparent)",
        "color":          "#6b7686",
        "iconColor":      "#6b7686",
        "iconGlyph":      "play",
        "cursor":         "not-allowed",
        "label":          "Commence",
        "sub":            "Arm a template first",
        "labelColor":     "#e7ecf2",
        "subColor":       "#4a5466"
      },
      "armed": {
        "background":     "[accent]",
        "border":         "1px solid [accent]",
        "color":          "#06150a",
        "iconColor":      "#06150a",
        "iconGlyph":      "play",
        "boxShadow":      "0 0 0 1px [accent], 0 0 22px [accentGlow], 0 8px 22px rgba(0, 0, 0, 0.5)",
        "cursor":         "pointer",
        "label":          "Commence",
        "sub":            "Start armed workers",
        "labelColor":     "#06150a",
        "subColor":       "rgba(6, 21, 10, 0.7)",
        "animation":      "lv1-armed-pulse 1.8s ease-in-out infinite"
      },
      "running": {
        "background":     "color-mix(in srgb, [accent] 22%, transparent)",
        "border":         "1px solid [accent]",
        "color":          "[accent]",
        "iconColor":      "[accent]",
        "iconGlyph":      "pause-bars",
        "boxShadow":      "none",
        "cursor":         "default",
        "label":          "Running",
        "sub":            "Workers live",
        "labelColor":     "[accent]",
        "subColor":       "[accent]"
      }
    },
    "_compactLabels": {
      "idle":    "GO",
      "armed":   "GO",
      "running": "LIVE"
    }
  },

  "footer": {
    "borderTop": "1px solid color-mix(in srgb, #1c232d 60%, transparent)",
    "padding":   "6px 4px 0",
    "margin":    "0 8px 8px",
    "layout": {
      "compact":     "column",
      "comfortable": "row"
    },
    "controls": ["density toggle", "spawnMode toggle"],
    "toggleButton": {
      "padding": {
        "compact":     "5px 0",
        "comfortable": "5px 8px"
      },
      "borderRadius": 5,
      "color":        "#6b7686",
      "fontFamily":   "ui-monospace",
      "fontSize":     10,
      "cursor":       "pointer"
    }
  },

  "spawnedTile": {
    "defaultSize": { "w": 280, "h": 180 },
    "background":   "#0f141b",
    "border":       "1px solid color-mix(in srgb, [roleColor] 60%, #1c232d)",
    "borderRadius": 8,
    "boxShadow": {
      "idle":    "0 8px 22px rgba(0, 0, 0, 0.5)",
      "running": "0 0 0 1px color-mix(in srgb, [roleColor] 35%, transparent), 0 12px 26px rgba(0, 0, 0, 0.55)"
    },
    "titleBar": {
      "minHeight":    30,
      "padding":      "6px 11px",
      "background":   "color-mix(in srgb, #0a0d12 60%, transparent)",
      "borderBottom": "1px solid color-mix(in srgb, #1c232d 70%, transparent)",
      "borderTop":    "2px solid [roleColor]",
      "fontFamily":   "ui-monospace",
      "fontSize":     11
    },
    "statusPill": {
      "fontSize":       9,
      "padding":        "2px 7px",
      "borderRadius":   999,
      "textTransform": "uppercase",
      "letterSpacing": "0.08em",
      "lineHeight":     1.3,
      "values": {
        "PENDING": "#f59e0b (armed-template tile, not yet running)",
        "LIVE":    "#5bd17a (running)",
        "IDLE":    "#6b7686 (spawned but no template)",
        "EXIT":    "#4a5466"
      }
    },
    "_pendingPulse": "@keyframes lv1-pending-pulse — outline glows armber every 2.4s"
  },

  "templateCable": {
    "_built": "Bezier curve between two template tiles (Hermes east port → PufferLib west port)",
    "states": {
      "armed_idle": {
        "stroke":         "color-mix(in srgb, #f59e0b 55%, transparent)",
        "strokeWidth":    1.6,
        "strokeDasharray": "6 5",
        "fill":           "none"
      },
      "running": {
        "primaryStroke":   "color-mix(in srgb, [accent] 70%, transparent)",
        "primaryWidth":    1.6,
        "overlay": {
          "stroke":         "[accentBright]",
          "strokeWidth":    1.6,
          "strokeDasharray":"8 8",
          "animation":      "cableFlow 1.6s linear infinite"
        }
      }
    }
  },

  "colors": {
    "_source": "quantflow-electron/src/main/role-service.ts + shell.css tokens",
    "bg":            "#0a0d12",
    "fg":            "#e7ecf2",
    "muted":         "#6b7686",
    "muted2":        "#4a5466",
    "border":        "#1c232d",
    "tileBorder":    "#1c232d",
    "accent":        "oklch(0.78 0.16 145)",
    "accentHex":     "#5bd17a",
    "accentGlow":    "oklch(0.78 0.16 145 / 0.18)",
    "armed":         "#f59e0b",
    "failed":        "oklch(0.68 0.19 25)",
    "roles": {
      "hermes": { "hex": "#06b6d4", "name": "teal-cyan", "_source": "NOT YET IN role-service.ts — placeholder until added" },
      "codex":  { "hex": "#38bdf8", "name": "sky" },
      "claude": { "hex": "#f97316", "name": "orange",  "_alias": "claude-worker in role-service" },
      "puffer": { "hex": "#f59e0b", "name": "amber",   "_alias": "planner color in role-service" },
      "python": { "hex": "#6366f1", "name": "indigo",  "_alias": "coder color in role-service" },
      "shell":  { "hex": "#64748b", "name": "slate" }
    }
  },

  "typography": {
    "fontSans": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "fontMono": "ui-monospace, 'SF Mono', Consolas, 'Liberation Mono', Menlo, monospace"
  },

  "keyframes": {
    "lv1-spawn-pulse": {
      "duration": "600ms",
      "ease":     "ease-out",
      "0":        { "transform": "scale(1)" },
      "50":       { "transform": "scale(1.06)" },
      "100":      { "transform": "scale(1)" },
      "_trigger": "Played on the recipe row when user clicks it (single play)"
    },
    "lv1-armed-pulse": {
      "duration":  "1.8s",
      "ease":      "ease-in-out",
      "iteration": "infinite",
      "0/100":     { "boxShadow": "0 0 0 1px [accent], 0 0 22px [accentGlow], 0 8px 22px rgba(0, 0, 0, 0.5)" },
      "50":        { "boxShadow": "0 0 0 1px [accent], 0 0 34px [accentGlow], 0 8px 22px rgba(0, 0, 0, 0.5)" },
      "_trigger":  "Played on the Commence button while in 'armed' state (loops until clicked or disarmed)"
    },
    "lv1-pending-pulse": {
      "duration":  "2.4s",
      "ease":      "ease-in-out",
      "iteration": "infinite",
      "0/100":     { "boxShadow": "0 8px 22px rgba(0, 0, 0, 0.5), 0 0 0 1px color-mix(in srgb, #f59e0b 18%, transparent)" },
      "50":        { "boxShadow": "0 8px 22px rgba(0, 0, 0, 0.5), 0 0 0 1px color-mix(in srgb, #f59e0b 45%, transparent)" },
      "_trigger":  "Played on template-spawned tiles while PENDING (loops until Commence)"
    },
    "cableFlow": {
      "duration":  "1.6s",
      "ease":      "linear",
      "iteration": "infinite",
      "_animates": "stroke-dashoffset on the running cable overlay"
    }
  }
}
